# .env NAMUNA — buni .env deb nusxalab, qiymatlarni to'ldiring (maxfiy, GitHub'ga yuklanmaydi)

# Telegram bot (@BotFather dan)
TG_BOT_TOKEN=123456:ABC...
TG_BOT_USERNAME=your_bot
TG_OWNER_ID=123456789

# my.telegram.org dan (lokal Bot API server va userbot uchun)
TG_API_ID=12345678
TG_API_HASH=abcdef0123456789abcdef0123456789

# Mini App havolasi (cloudflared avtomat beradi — web_url.txt; bu zaxira)
WEB_APP_URL=https://example.com

# Lokal Bot API server (2GB fayl limiti). 1 = yoqilgan
USE_LOCAL_BOT_API=1
LOCAL_BOT_API_URL=http://127.0.0.1:8081

# 1C (ixtiyoriy — /1c uchun; bo'sh qoldirsangiz ham bo'ladi)
ONEC_EXE=
ONEC_SRV=
ONEC_REF=
ONEC_USER=
ONEC_PASS=
ONEC_REPORTS_DIR=
